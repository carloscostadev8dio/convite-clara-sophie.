# Copie este arquivo para .streamlit/secrets.toml (uso local)
# ou cole o conteúdo em  Settings > Secrets  no Streamlit Community Cloud.
# NUNCA suba o secrets.toml real para o GitHub.

ADMIN_PASSWORD = "troque-por-uma-senha-longa-e-unica"

# Número com DDI+DDD, só dígitos (ex.: 5592999999999). Opcional: mostra botão de WhatsApp.
WHATSAPP_NUMBER = ""

# ID da planilha do Google (trecho entre /d/ e /edit na URL)
SHEET_ID = "https://docs.google.com/spreadsheets/d/1nOdt8Y4vRn1kNBn5erPa7AlARnwV4EfHxZk8_UqjJmk/edit?usp=sharing"

# Conteúdo do JSON da conta de serviço do Google Cloud
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
